# ─── Token Guard Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in the keys for providers you use.

# Server
TOKEN_GUARD_HOST=0.0.0.0
TOKEN_GUARD_PORT=8088

# API Keys — add only what you need
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...

# ─── Optimization Tuning ────────────────────────────────────────────────────
ENABLE_EXACT_CACHE=true
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.85

ENABLE_SCHEMA_MINIFIER=true

ENABLE_HISTORY_CONDENSER=true
MAX_HISTORY_TURNS=6

ENABLE_PROMPT_PRUNER=true
PRUNER_AGGRESSIVENESS=medium    # light | medium | aggressive
