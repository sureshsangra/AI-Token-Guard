{
  "manifest_version": 3,
  "name": "Token Guard - AI Token Optimizer",
  "version": "1.0.0",
  "description": "Automatically prunes and optimizes prompt tokens for ChatGPT, Claude.ai, and Gemini web.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:8088/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
